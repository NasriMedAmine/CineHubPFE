# Copier ce fichier en ".env" (pour Prisma) et en ".env.local" (pour Next.js),
# puis remplacer les valeurs si besoin.

# Chemin de la base SQLite (relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Clé de l'API Anthropic (Claude) pour l'assistant IA.
# Laisser vide : l'assistant affiche alors un message de configuration
# et propose un simple filtrage du catalogue (clairement indiqué comme "non IA").
ANTHROPIC_API_KEY=""

# Modèle utilisé par l'assistant (optionnel)
AI_MODEL="claude-opus-5-5"
