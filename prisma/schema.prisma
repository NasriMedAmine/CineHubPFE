// Schéma de la base de données CineHub (SQLite + Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Un utilisateur inscrit
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  reviews   Review[]
  favorites Favorite[]
  library   PersonalLibrary[]
  sessions  Session[]
}

// Un film du catalogue partagé (visible par tout le monde)
model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  poster      String
  description String
  genre       String
  releaseYear Int
  director    String
  duration    Int // durée en minutes
  createdAt   DateTime @default(now())

  // La note moyenne n'est PAS stockée : elle est calculée à partir des avis.
  reviews   Review[]
  favorites Favorite[]
  libraries PersonalLibrary[]
}

// Un avis (note de 1 à 5 + commentaire). Un seul avis par utilisateur et par film.
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

// Un film mis en favori par un utilisateur
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

// Une entrée de la bibliothèque personnelle d'un utilisateur
// status : "TO_WATCH" (à voir), "WATCHING" (en cours), "WATCHED" (vu)
model PersonalLibrary {
  id           Int      @id @default(autoincrement())
  userId       Int
  movieId      Int
  personalNote String   @default("")
  status       String   @default("TO_WATCH")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

// Une session de connexion. Le cookie contient un jeton aléatoire,
// la base ne stocke que son empreinte SHA-256.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
